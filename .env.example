# Plantilla de variables de entorno (sin secretos reales).
# Copia este archivo a `.env` en la raíz del proyecto y rellena solo en tu máquina.
# Nunca subas `.env` a Git (está en .gitignore). Los valores aquí deben quedar vacíos o de ejemplo genérico.

# --- Companies House (Reino Unido) ---
COMPANIES_HOUSE_API_KEY=

# --- Google Gemini (opcional) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_UPLOAD_BYTES=1000000
# GEMINI_SKIP_ANALYSIS=1
# GEMINI_MAX_UPLOAD_BYTES=0 desactiva el recorte (riesgo de error por tokens).
# Timeout (ms) para síntesis de texto del grafo LangGraph (dossier ejecutivo):
# GEMINI_TEXT_TIMEOUT_MS=120000
# Tamaño máximo (caracteres) del JSON enviado a Gemini en POST /dossiers/person/research:
# GEMINI_PERSON_MAX_JSON_CHARS=120000
# Si Netrows no devuelve perfiles: informe OSINT con Gemini + **Google Search** (grounding; coste según Google):
# GEMINI_PERSON_WEB_MODEL=gemini-2.5-flash
# GEMINI_PERSON_WEB_TIMEOUT_MS=180000
# Por defecto (1) Gemini+búsqueda web en **cada** investigación de persona (además del análisis Netrows si hay datos).
# Pon 0 para usar búsqueda web solo cuando Netrows no devuelve perfiles:
# GEMINI_PERSON_WEB_ALWAYS=1
# GEMINI_DISABLE_GOOGLE_SEARCH=1
# Body JSON `research_source`: `gemini_web` (solo IA + Google Search) o `netrows` (API Netrows + Gemini; requiere NETROWS_API_KEY).
# Dossier corporativo (API): analizar con Gemini el **primer filing** descargable de CH
# además de la síntesis final. En free tier suele consumir 2 peticiones por dossier.
# Pon 0 para omitir solo ese paso y ahorrar cuota (429 RESOURCE_EXHAUSTED):
# DOSSIER_CORPORATE_CH_FILING_GEMINI=0
# Igual para el análisis Gemini del primer HTML principal de un filing SEC (EDGAR):
# DOSSIER_CORPORATE_SEC_FILING_GEMINI=0
# Reintentos extra (subida + generate) ante 503 UNAVAILABLE / timeouts en ese paso (2–8, por defecto 5):
# GEMINI_CORPORATE_FILING_OUTER_RETRIES=5
# Cuántos envíos recientes de submissions se miran al elegir el HTML para Gemini (12–120, por defecto 60):
# DOSSIER_SEC_GEMINI_FILING_SCAN_MAX=60
# Resumen XBRL (Company Facts API, una petición más a data.sec.gov). Desactivar: 0
# DOSSIER_SEC_COMPANY_FACTS=0
# Tamaño máximo del JSON resumido en el contexto (caracteres):
# DOSSIER_SEC_COMPANY_FACTS_MAX_CHARS=14000

# --- Netrows (API B2B / datos profesionales; solo para pruebas en tests/netrows/) ---
# NETROWS_API_KEY=
# Opcional: URL base si Netrows cambia el host (por defecto https://www.netrows.com/api/v1)
# NETROWS_API_URL=https://www.netrows.com/api/v1

# --- OpenAI (solo si usas DOSSIER_LEGACY_OPENAI=1 para el dossier sin LangGraph) ---
OPENAI_API_KEY=
# DOSSIER_LEGACY_OPENAI=1

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=

# --- Microsoft / Outlook (calendario Graph) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- PostgreSQL (opcional; solo si usas la base del proyecto) ---
# Opción A: URL completa
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/nombre_bd

# Opción B: variables separadas (rellena contraseña solo en tu `.env` local, no en commits)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=dossier

# --- Auth del dashboard (registro / login email+contraseña → JWT) ---
# Genera un valor largo y aleatorio; mínimo 16 caracteres (32+ recomendado en producción).
JWT_SECRET=
# Minutos de validez del token (por defecto 10080 = 7 días).
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Créditos iniciales de la organización al registrarse (por defecto en API: **10** si omites esto; alineado con tier Free del informe).
# ORG_SIGNUP_CREDITS=10
# ORG_SIGNUP_CREDITS_MONTHLY_LIMIT=10
# Cobro al generar dossier corporativo (1 / 3 / 5 créditos según profundidad). El descuento lo aplica el trigger en PostgreSQL.
# Pon 0 para desactivar cobro en entornos de demo: DOSSIER_CHARGE_CREDITS=0
# DOSSIER_CHARGE_CREDITS=true
# Tras ejecutar docs/sql/schema_project_dossier.sql en PostgreSQL, puedes poner:
# DATABASE_AUTO_CREATE_TABLES=0
# Orígenes del frontend permitidos por CORS (coma; se normalizan espacios y barra final).
# Incluye producción y previews de Vercel, p. ej.:
# CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
# Por defecto la API acepta cualquier Origin https://*.vercel.app (regex); desactivar con:
# CORS_ALLOW_VERCEL_APP_REGEX=0
# Patrón regex alternativo (opcional, si necesitas restringir previews):
# CORS_VERCEL_ORIGIN_REGEX=https://tu-proyecto[\w.-]*\.vercel\.app
