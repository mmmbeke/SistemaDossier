# Copia este archivo a .env y rellena los valores.
# Raíz del proyecto: SistemaDossier/.env

# Companies House (ApiUK.py)
COMPANIES_HOUSE_API_KEY=

# Opcional — main.py (comprobación en /)
# OPENAI_API_KEY=
# GOOGLE_CLIENT_ID=

# Opcional — Gemini (ApiUK.py, gemini_analyze.py, sec_edgar_apple.py)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Tope de bytes enviados a Gemini (solo inicio del archivo). Entero > 0.
# GEMINI_MAX_UPLOAD_BYTES=1000000
# Sin esta variable, archivos mayores que dossier_limits.DEFAULT_GEMINI_MAX_UPLOAD_BYTES
# se recortan igualmente. GEMINI_MAX_UPLOAD_BYTES=0 desactiva el recorte (riesgo de error por tokens).
