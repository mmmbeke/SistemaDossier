# Copia este archivo a .env en la raíz del proyecto (no subas .env a git).
# Cada desarrollador usa sus propias claves y su PostgreSQL local.

# --- Companies House (Reino Unido) ---
COMPANIES_HOUSE_API_KEY=

# --- Google Gemini (opcional) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_UPLOAD_BYTES=1000000
# GEMINI_SKIP_ANALYSIS=1

# --- PostgreSQL (opcional; solo si usas la base de datos en el proyecto) ---
# Opción A: URL completa (recomendada si ya la tienes)
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/nombre_bd

# Opción B: variables por separado (la app construye la URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto_en_tu_local
POSTGRES_DB=dossier

# --- Otros (opcional) ---
# OPENAI_API_KEY=
# GOOGLE_CLIENT_ID=
