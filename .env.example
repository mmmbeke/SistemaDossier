# Plantilla de variables de entorno (sin secretos reales).
# Copia este archivo a `.env` en la raíz del proyecto y rellena solo en tu máquina.
# Nunca subas `.env` a Git (está en .gitignore). Los valores aquí deben quedar vacíos o de ejemplo genérico.

# --- Companies House (Reino Unido) ---
COMPANIES_HOUSE_API_KEY=

# --- Google Gemini (opcional) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_UPLOAD_BYTES=1000000
# GEMINI_SKIP_ANALYSIS=1
# GEMINI_MAX_UPLOAD_BYTES=0 desactiva el recorte (riesgo de error por tokens).
# Timeout (ms) para síntesis de texto del grafo LangGraph (dossier ejecutivo):
# GEMINI_TEXT_TIMEOUT_MS=120000
# Dossier corporativo (API): analizar con Gemini el **primer filing** descargable de CH
# además de la síntesis final. En free tier suele consumir 2 peticiones por dossier.
# Pon 0 para omitir solo ese paso y ahorrar cuota (429 RESOURCE_EXHAUSTED):
# DOSSIER_CORPORATE_CH_FILING_GEMINI=0

# --- OpenAI (solo si usas DOSSIER_LEGACY_OPENAI=1 para el dossier sin LangGraph) ---
OPENAI_API_KEY=
# DOSSIER_LEGACY_OPENAI=1

# --- Google OAuth (opcional) ---
GOOGLE_CLIENT_ID=

# --- Microsoft / Outlook (calendario Graph) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- PostgreSQL (opcional; solo si usas la base del proyecto) ---
# Opción A: URL completa
# DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/nombre_bd

# Opción B: variables separadas (rellena contraseña solo en tu `.env` local, no en commits)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=dossier

# --- Auth del dashboard (registro / login email+contraseña → JWT) ---
# Genera un valor largo y aleatorio; mínimo 16 caracteres (32+ recomendado en producción).
JWT_SECRET=
# Minutos de validez del token (por defecto 10080 = 7 días).
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Créditos iniciales de la organización al registrarse (por defecto en API: 500 si omites esto).
# ORG_SIGNUP_CREDITS=500
# ORG_SIGNUP_CREDITS_MONTHLY_LIMIT=500
# Tras ejecutar docs/sql/schema_project_dossier.sql en PostgreSQL, puedes poner:
# DATABASE_AUTO_CREATE_TABLES=0
# Orígenes del frontend permitidos por CORS (coma, sin espacios extra si quieres).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
